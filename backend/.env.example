# Copy to .env and adjust. NEVER commit real secrets.
# Every variable is optional unless marked REQUIRED. Prefix: LGA_

# --- app ---
LGA_APP_ENV=local
LGA_HOST=0.0.0.0
LGA_PORT=8000
# Comma-separated origins allowed to call the API from a browser
LGA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- model provider: ollama | groq | gemini | openrouter ---
LGA_PROVIDER=ollama

# Ollama (local, required for the demo)
LGA_OLLAMA_BASE_URL=http://localhost:11434
LGA_OLLAMA_CHAT_MODEL=qwen2.5:7b
LGA_OLLAMA_EMBED_MODEL=nomic-embed-text
LGA_OLLAMA_TIMEOUT_S=60

# Cloud fallback (optional). If LGA_CLOUD_API_KEY is missing or the call
# fails, the backend falls back to Ollama and says so in the response.
# REQUIRED only when LGA_PROVIDER != ollama
# LGA_CLOUD_API_KEY=
# Model id for the selected cloud provider, e.g.:
#   groq:      llama-3.3-70b-versatile
#   gemini:    gemini-2.0-flash
#   openrouter: meta-llama/llama-3.3-70b-instruct:free
LGA_CLOUD_CHAT_MODEL=

# --- database ---
LGA_DATABASE_URL=postgresql+psycopg://lga:lga@localhost:5432/lga
LGA_DB_POOL_SIZE=5

# --- retrieval ---
LGA_VECTOR_DIM=768
LGA_RETRIEVAL_TOP_K=6
